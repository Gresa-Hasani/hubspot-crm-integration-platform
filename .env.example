# Copy this file to .env and fill in real values for local development.
# Never commit the real .env file.

# PostgreSQL
POSTGRES_DB=crm_integration
POSTGRES_USER=crm_user
POSTGRES_PASSWORD=change-me-locally
POSTGRES_PORT=5432

# ASP.NET Core Web API
ASPNETCORE_ENVIRONMENT=Development
API_HTTP_PORT=8080
ConnectionStrings__Default=Host=postgres;Port=5432;Database=crm_integration;Username=crm_user;Password=change-me-locally

# HubSpot (use a HubSpot private-app access token for local development — see README "HubSpot Setup")
HubSpot__BaseUrl=https://api.hubapi.com
HubSpot__AccessToken=<paste-your-hubspot-private-app-token-here>
HubSpot__ClientId=
HubSpot__ClientSecret=
HubSpot__WebhookSigningSecret=<paste-your-hubspot-app-client-secret-here>

# Internal JWT authentication
Jwt__Issuer=CrmIntegrationPlatform
Jwt__Audience=CrmIntegrationPlatformClients
Jwt__SigningKey=replace-with-a-long-random-signing-key-at-least-32-bytes
Jwt__ExpirationMinutes=60
Jwt__RefreshTokenExpirationDays=14

# One-time initial Admin bootstrap (Phase 8) — only runs when no ApplicationUsers exist yet.
# Leave both blank to skip bootstrap entirely (e.g. once you already have an Admin).
BootstrapAdmin__Email=
BootstrapAdmin__Password=

# Comma-is-not-valid-here: set as separate ASPNETCORE-style array indices if ever needed via env,
# or prefer appsettings.{Environment}.json for this one. Left unset (no CORS) until Phase 10 needs it.
# Cors__AllowedOrigins__0=http://localhost:5173
